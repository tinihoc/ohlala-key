#Requires AutoHotkey v2.0
; ==============================================================================
; InputHookManager.ahk - Global Low-Level Event Interceptor
; Part of OhlalaKey / OpenKey Polyglot IME
; ==============================================================================

class InputHookManager {
    ih := unset
    wordBuf := unset
    polyglot := unset
    vietnamese := unset
    macroMgr := unset
    isRunning := false

    __New(wordBuf, polyglot, vietnamese, macroMgr) {
        this.wordBuf := wordBuf
        this.polyglot := polyglot
        this.vietnamese := vietnamese
        this.macroMgr := macroMgr

        this.InitHook()
        this.RegisterMouseHooks()
    }

    InitHook() {
        ; Option "V": Visible characters (characters pass through naturally to active control)
        ; Option "I2": Ignore synthetic keystrokes generated by AHK to prevent recursive loops
        this.ih := InputHook("V I2")

        ; Notify on all keys
        this.ih.KeyOpt("{All}", "N")

        ; Bind callbacks
        this.ih.OnChar := ObjBindMethod(this, "ProcessChar")
        this.ih.OnKeyDown := ObjBindMethod(this, "ProcessKeyDown")
    }

    ; Register mouse click hooks to flush word buffer on focus change
    RegisterMouseHooks() {
        try {
            Hotkey("~*LButton", ObjBindMethod(this, "OnMouseClick"), "On")
            Hotkey("~*RButton", ObjBindMethod(this, "OnMouseClick"), "On")
        } catch {
            ; Non-fatal if mouse hook cannot be bound in certain test environments
        }
    }

    Start() {
        if (!this.isRunning) {
            this.ih.Start()
            this.isRunning := true
        }
    }

    Stop() {
        if (this.isRunning) {
            this.ih.Stop()
            this.isRunning := false
        }
    }

    OnMouseClick(hotkeyName := "") {
        this.wordBuf.Reset()
        this.polyglot.ResetPunctuation()
    }

    ; --------------------------------------------------------------------------
    ; Process Printable Character Events
    ; --------------------------------------------------------------------------
    ProcessChar(hook, char) {
        ; 1. Word Boundary: Space
        if (char == " ") {
            ; Check macro expansion on space
            expanded := this.macroMgr.CheckAndExpand(this.wordBuf, " ")
            if (!expanded) {
                this.wordBuf.Reset()
                this.polyglot.ClearPunctState()
            }
            return
        }

        ; Record raw keystroke for English auto-restore
        this.wordBuf.AppendRaw(char)

        ; 2. Punctuation Handling (Spanish ¡, ¿ and French Guillemets « »)
        if (char == "!" || char == "?" || char == "'") {
            handledPunct := this.polyglot.HandlePunctuation(char, this.wordBuf)
            if (handledPunct)
                return
        }

        ; 3. Polyglot Foreign Rules (Cedilla ç, Eñe ñ, Ligatures œ/æ, Tréma ä/ö/ü, etc.)
        if (this.polyglot.enabled) {
            handledPoly := this.polyglot.Process(char, this.wordBuf)
            if (handledPoly)
                return
        }

        ; 4. Vietnamese IME Syllable Rules (Telex/VNI modifiers, circumflexes, horns, tones)
        ; Suppress Vietnamese tone modification inside French guillemets so French words (like 'bonjour') type cleanly
        if (!this.polyglot.isGuillemetOpen) {
            handledViet := this.vietnamese.Process(char, this.wordBuf)
            if (handledViet)
                return
        }

        ; 5. Punctuation Word Boundaries (e.g. , . ; : ! ?)
        if (InStr(",.;:!?()[]{}`"/\-+=*&^%$#@~<>|", char)) {
            expanded := this.macroMgr.CheckAndExpand(this.wordBuf, char)
            if (!expanded) {
                this.wordBuf.Reset()
            }
            return
        }

        ; 6. Normal character struck -> Push to word buffer
        isUpper := (char == StrUpper(char) && char != StrLower(char))
        this.wordBuf.PushChar(char, char, isUpper)
    }

    ; --------------------------------------------------------------------------
    ; Process Non-Printable & Navigation Keys
    ; --------------------------------------------------------------------------
    ProcessKeyDown(hook, vk, sc) {
        keyName := GetKeyName(Format("vk{:02x}sc{:03x}", vk, sc))

        ; Backspace: User physically struck Backspace -> Pop token
        if (keyName == "Backspace" || vk == 0x08) {
            this.wordBuf.Pop()
            this.polyglot.ResetPunctuation()
            return
        }

        ; Word Terminators & Navigation Keys: Reset Buffer
        if (InStr("Enter|Tab|Escape|Left|Right|Up|Down|Home|End|PgUp|PgDn|Delete", keyName)) {
            this.wordBuf.Reset()
            this.polyglot.ResetPunctuation()
            return
        }
    }
}
